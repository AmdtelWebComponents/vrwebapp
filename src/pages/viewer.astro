---
import { rooms } from '../lib/rooms.js';
import ViewerTopBar from '../components/ViewerTopBar.astro';
import ViewerSettingsPanel from '../components/ViewerSettingsPanel.astro';
import ViewerDebugPanel from '../components/ViewerDebugPanel.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>VR Viewer | VR House</title>
    <style>
      :root {
        --panel: rgba(18, 23, 32, 0.76);
        --panel-border: rgba(255, 255, 255, 0.14);
        --text: #f6f5ef;
        --muted: #d7d4c4;
        --action: #db7f2a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'Sora', 'Segoe UI', sans-serif;
        color: var(--text);
        background: #10141a;
      }

      #canvas-container {
        width: 100%;
        height: 100vh;
        position: relative;
      }

      @media (max-width: 640px) {
        body {
          font-size: 15px;
        }
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      if (new URL(window.location.href).searchParams.get('menu') === 'hidden') {
        document.documentElement.dataset.viewerMenuHidden = 'true';
      }
    </script>
  </head>
  <body>
    <div id="canvas-container">
      <ViewerTopBar>
        <ViewerSettingsPanel slot="menu" rooms={rooms} />
        <ViewerDebugPanel slot="debug" />
      </ViewerTopBar>
    </div>

    <script>
      import { rooms } from '../lib/rooms.js';
      import { getLocalRoomShell, readLocalModelBlobUrl } from '../lib/localModelStore.js';

      type SurfaceKey = 'all' | 'walls' | 'ceiling' | 'floor' | 'objects';
      type ViewerController = {
        loadRoom: (room: (typeof rooms)[number]) => Promise<void>;
        getEditableSurfaceSummary: () => Record<SurfaceKey, number>;
        setSurfaceAppearance: (
          groupId: SurfaceKey,
          values: { color?: string; preset?: string; roughness?: number; metalness?: number }
        ) => { updated: number };
        resetSurfaceAppearance: (groupId?: SurfaceKey) => { updated: number };
        isVRSupported: () => boolean;
        startVRSession: (onStart?: () => void, onEnd?: () => void) => Promise<void>;
        dispose: () => void;
      };

      type ViewerPerformanceEvent = {
        phase: 'loader-ready' | 'environment-ready' | 'room-ready' | 'background-ready';
        totalMs: number;
        loader?: 'gltf-draco' | 'hdr';
        pmremMs?: number;
        roomId?: string;
        gltfLoadMs?: number;
        fitMs?: number;
        surfaceIndexMs?: number;
        surfaceCount?: number;
        reason?: string;
      };

      const container = document.getElementById('canvas-container') as HTMLDivElement;
      const roomSelect = document.getElementById('room-select') as HTMLSelectElement;
      const status = document.getElementById('status') as HTMLElement;
      const vrBtn = document.getElementById('vr-btn') as HTMLButtonElement;
      const materialTarget = document.getElementById('material-target') as HTMLSelectElement;
      const materialColor = document.getElementById('material-color') as HTMLInputElement;
      const materialPreset = document.getElementById('material-preset') as HTMLSelectElement;
      const materialRoughness = document.getElementById('material-roughness') as HTMLInputElement;
      const materialMetalness = document.getElementById('material-metalness') as HTMLInputElement;
      const materialApply = document.getElementById('material-apply') as HTMLButtonElement;
      const materialReset = document.getElementById('material-reset') as HTMLButtonElement;
      const materialStatus = document.getElementById('material-status') as HTMLElement;
      const topbar = document.querySelector('.topbar') as HTMLElement;
      const toggle = document.getElementById('topbar-toggle') as HTMLButtonElement | null;
      const debugPanel = document.getElementById('viewer-debug') as HTMLElement | null;
      const debugToggle = document.getElementById('viewer-debug-toggle') as HTMLButtonElement | null;
      const debugLog = document.getElementById('debug-log') as HTMLElement | null;
      const kpiModule = document.getElementById('kpi-module') as HTMLElement | null;
      const kpiDraco = document.getElementById('kpi-draco') as HTMLElement | null;
      const kpiHdr = document.getElementById('kpi-hdr') as HTMLElement | null;
      const kpiRoom = document.getElementById('kpi-room') as HTMLElement | null;
      const kpiEnv = document.getElementById('kpi-env') as HTMLElement | null;
      const kpiBg = document.getElementById('kpi-bg') as HTMLElement | null;
      const localObjectUrls = new Set<string>();

      function toMs(value: number | undefined) {
        return typeof value === 'number' ? `${value.toFixed(1)}ms` : '-';
      }

      function addDebugLog(line: string) {
        if (!debugLog) return;
        const row = document.createElement('p');
        row.className = 'debug-log-row';
        row.textContent = line;
        debugLog.prepend(row);

        while (debugLog.childElementCount > 12) {
          debugLog.removeChild(debugLog.lastElementChild as Node);
        }
      }

      debugToggle?.addEventListener('click', () => {
        if (!debugPanel) return;
        const open = debugPanel.dataset.open === 'true';
        debugPanel.dataset.open = String(!open);
        debugToggle.setAttribute('aria-expanded', String(!open));
        debugToggle.textContent = open ? 'Open' : 'Close';
      });

      toggle?.addEventListener('click', () => {
        const open = topbar.dataset.open === 'true';
        topbar.dataset.open = String(!open);
        toggle.setAttribute('aria-expanded', String(!open));
      });

      function getRoomFromUrl() {
        return new URL(window.location.href).searchParams.get('room');
      }

      function writeUrl(roomId: string) {
        const url = new URL(window.location.href);
        url.searchParams.set('room', roomId);
        window.history.replaceState({}, '', url);
      }

      function syncLocalRoomOption() {
        const existing = roomSelect.querySelector('option[value="__local__"]');
        const shell = getLocalRoomShell();

        if (!shell && existing) {
          existing.remove();
          return;
        }

        if (shell && !existing) {
          const option = document.createElement('option');
          option.value = '__local__';
          option.textContent = `Local: ${shell.name}`;
          roomSelect.insertBefore(option, roomSelect.firstChild);
          return;
        }

        if (shell && existing) {
          existing.textContent = `Local: ${shell.name}`;
        }
      }

      async function resolveRoomById(roomId: string | null) {
        if (roomId === '__local__') {
          const modelUrl = await readLocalModelBlobUrl();
          const shell = getLocalRoomShell();
          if (modelUrl && shell) {
            localObjectUrls.add(modelUrl);
            return { ...shell, modelUrl };
          }
          return null;
        }

        return rooms.find((room) => room.id === roomId) || null;
      }

      function refreshMaterialTargets(viewer: ViewerController) {
        if (!materialTarget) return;
        const summary = viewer.getEditableSurfaceSummary();
        for (const option of materialTarget.options) {
          const key = option.value as SurfaceKey;
          const label = option.textContent?.split('(')[0]?.trim() || option.textContent || key;
          option.textContent = `${label} (${summary[key] ?? 0})`;
        }
      }

      function setRoomStatus(room: (typeof rooms)[number]) {
        if (!status) return;
        status.textContent = room.isMock
          ? `${room.name} loaded (mock model)`
          : `${room.name} loaded`;
      }

      function logViewerPerformance(event: ViewerPerformanceEvent) {
        if (event.phase === 'loader-ready') {
          if (event.loader === 'gltf-draco' && kpiDraco) {
            kpiDraco.textContent = toMs(event.totalMs);
          }
          if (event.loader === 'hdr' && kpiHdr) {
            kpiHdr.textContent = toMs(event.totalMs);
          }
          addDebugLog(`loader:${event.loader} ${toMs(event.totalMs)}`);
          console.info('[viewer] loader-ready', event);
          return;
        }

        if (event.phase === 'environment-ready') {
          if (kpiEnv) {
            kpiEnv.textContent = `${toMs(event.totalMs)} / pmrem ${toMs(event.pmremMs)}`;
          }
          addDebugLog(`env ${toMs(event.totalMs)} pmrem ${toMs(event.pmremMs)}`);
          console.info('[viewer] environment-ready', event);
          return;
        }

        if (event.phase === 'background-ready') {
          if (kpiBg) {
            kpiBg.textContent = `${toMs(event.totalMs)} (${event.reason ?? 'n/a'})`;
          }
          addDebugLog(`background ${toMs(event.totalMs)} reason=${event.reason ?? 'n/a'}`);
          console.info('[viewer] background-ready', event);
          return;
        }

        if (kpiRoom) {
          kpiRoom.textContent = `${toMs(event.totalMs)} (${event.surfaceCount ?? 0} surfaces)`;
        }
        addDebugLog(
          `room ${event.roomId ?? 'unknown'} total ${toMs(event.totalMs)} gltf ${toMs(event.gltfLoadMs)} fit ${toMs(event.fitMs)} idx ${toMs(event.surfaceIndexMs)}`
        );

        console.info('[viewer] room-ready', event);
      }

      syncLocalRoomOption();

      const initialRoomId = getRoomFromUrl();
      let activeRoom = await resolveRoomById(initialRoomId);

      if (!activeRoom) {
        activeRoom = rooms[0];
      }

      if (roomSelect) {
        roomSelect.value = activeRoom.id;
      }

      if (status) {
        status.textContent = 'Preparing viewer...';
      }
      const moduleImportStartedAt = performance.now();
      const { initVRViewer } = await import('../lib/vrViewer.js');
      const moduleImportMs = Math.round((performance.now() - moduleImportStartedAt) * 10) / 10;
      if (kpiModule) {
        kpiModule.textContent = `${moduleImportMs.toFixed(1)}ms`;
      }
      addDebugLog(`module ${moduleImportMs.toFixed(1)}ms`);
      console.info('[viewer] module-ready', {
        moduleImportMs
      });

      if (status) {
        status.textContent = `Loading ${activeRoom.name}...`;
      }
      let viewer: ViewerController;
      viewer = await initVRViewer(container, {
        initialRoom: activeRoom,
        onPerformanceEvent: logViewerPerformance,
        deferBackground: true,
        backgroundDelayMs: 900,
        onRoomChange(room: (typeof rooms)[number]) {
          activeRoom = room;
          roomSelect.value = room.id;
          setRoomStatus(room);
          refreshMaterialTargets(viewer);
        }
      });

      setRoomStatus(activeRoom);
      refreshMaterialTargets(viewer);

      function getMaterialValues() {
        const roughness = Number.parseFloat(materialRoughness.value);
        const metalness = Number.parseFloat(materialMetalness.value);
        const preset = materialPreset.value;

        return {
          color: materialColor.value,
          preset: preset === 'custom' ? undefined : preset,
          roughness,
          metalness
        };
      }

      materialApply.addEventListener('click', () => {
        const result = viewer.setSurfaceAppearance(materialTarget.value as SurfaceKey, getMaterialValues());
        materialStatus.textContent = `Updated ${result.updated} material(s).`;
      });

      materialReset.addEventListener('click', () => {
        const result = viewer.resetSurfaceAppearance(materialTarget.value as SurfaceKey);
        materialStatus.textContent = `Reset ${result.updated} material(s).`;
      });

      if (viewer.isVRSupported()) {
        if (vrBtn) {
          vrBtn.style.display = 'inline-block';
          vrBtn.addEventListener('click', () => {
            viewer.startVRSession(
              () => { vrBtn.textContent = 'Exit VR'; },
              () => { vrBtn.textContent = 'Enter VR'; }
            );
          });
        }
      }

      roomSelect?.addEventListener('change', async (event) => {
        const selectedId = (event.target as HTMLSelectElement).value;
        const room = await resolveRoomById(selectedId);
        if (!room) return;

        if (status) {
          status.textContent = `Loading ${room.name}...`;
        }
        await viewer.loadRoom(room);
        writeUrl(room.id);
      });

      window.addEventListener(
        'pagehide',
        () => {
          viewer?.dispose();
          for (const localUrl of localObjectUrls) {
            URL.revokeObjectURL(localUrl);
          }
        },
        { once: true }
      );
    </script>
  </body>
</html>
