---
const { hideMenu = false } = Astro.props as {
  hideMenu?: boolean;
};
---

<div class="topbar" data-open="true">
  {!hideMenu && (
    <button class="topbar-toggle" id="topbar-toggle" aria-expanded="true" aria-controls="topbar-body">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 4l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Menu
    </button>
  )}

  <div class="topbar-body" id="topbar-body">
    <div class="topbar-titlebar">
      <span class="topbar-title">Viewer Controls</span>
      <span class="topbar-subtitle">Settings and diagnostics</span>
    </div>

    <div class="topbar-content">
      {!hideMenu && (
        <div class="topbar-menu">
          <slot name="menu" />
        </div>
      )}

      <div class="topbar-debug">
        <slot name="debug" />
      </div>
    </div>
  </div>
</div>

<style>
  .topbar {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    border-radius: 12px;
    border: 1px solid var(--panel-border);
    background: var(--panel);
    backdrop-filter: blur(5px);
    overflow: hidden;
    width: min(720px, calc(100vw - 1.5rem));
  }

  .topbar-toggle {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: transparent;
    border: none;
    color: var(--text);
    font: 600 0.9rem/1 inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .topbar-toggle svg {
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .topbar[data-open='false'] .topbar-toggle svg {
    transform: rotate(-90deg);
  }

  .topbar-body {
    display: grid;
    gap: 0.75rem;
    padding: 0 0.55rem 0.55rem;
  }

  .topbar-titlebar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.2rem 0.2rem 0;
    color: var(--muted);
  }

  .topbar-title {
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .topbar-subtitle {
    font-size: 0.76rem;
  }

  .topbar-content {
    display: grid;
    gap: 0.65rem;
  }

  .topbar-debug {
    display: grid;
    gap: 0.6rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--panel-border);
  }

  .topbar[data-open='false'] .topbar-body {
    display: none;
  }

  :global(html[data-viewer-menu-hidden='true']) .topbar-toggle,
  :global(html[data-viewer-menu-hidden='true']) .topbar-menu {
    display: none;
  }

  :global(html[data-viewer-menu-hidden='true']) .topbar-debug {
    border-top: 0;
    padding-top: 0;
  }

  #vr-btn {
    display: none;
  }

  @media (max-width: 640px) {
    .topbar {
      right: 0.75rem;
      left: 0.75rem;
      width: auto;
    }
  }
</style>
