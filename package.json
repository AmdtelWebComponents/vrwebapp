{
  "name": "vrwebapp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "models:export": "blender -b blender/kellyburn_NewPlans_draft.blend -P blender/export_rooms.py -- --outdir public/models --profile standard",
    "models:export:quest": "blender -b blender/kellyburn_NewPlans_draft.blend -P blender/export_rooms.py -- --outdir public/models --profile quest",
    "models:audit": "blender -b blender/kellyburn_NewPlans_draft.blend -P blender/export_rooms.py -- --profile standard --audit-only",
    "models:audit:strict": "blender -b blender/kellyburn_NewPlans_draft.blend -P blender/export_rooms.py -- --profile standard --strict-audit --audit-only"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.1.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^7.0.2"
  }
}
